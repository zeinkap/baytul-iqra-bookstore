// Learn more about Prisma in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id          String   @id @default(uuid())
  title       String   @unique
  author      String
  description String
  price       Float
  costPrice   Float?   // Cost price for profit margin calculation
  shippingCost Float?   // Shipping cost per book for bulk orders
  images      String[] @db.Text
  stock       Int
  isBestseller Boolean  @default(false)
  format      String?  // Book format: Paperback, Hardcover, etc.
  ageRange    String?  // Target reader age, e.g. "6-9", "10-13", "14+", "All ages"
  isbn        String?  @unique // Normalized ISBN-10/13 (no hyphens); used in direct-to-cart QR URLs (/b/<isbn>)
  categories  Category[] @relation("BookCategories")
  scans       Scan[]
  stockCounts StockCount[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// One row per QR label scan (see /b/[code]); compare with paid in-shop orders to spot labels that don't convert
model Scan {
  id        String   @id @default(uuid())
  code      String   // what was in the URL (ISBN or book id)
  bookId    String?
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)
  status    String   // scans: "ok" | "sold-out" | "not-found"; failures: "buy-failed" | "page-error"
  detail    String?  // short reason for buy-failed / page-error events
  location  String?  // venue slug from the QR link (?loc=cafe-a)
  device    String?  // "ios" | "android" | "desktop" | "other"
  createdAt DateTime @default(now())

  @@index([bookId, createdAt])
  @@index([createdAt])
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[] @relation("BookCategories")
}

model PromoCode {
  id          String   @id @default(uuid())
  code        String   @unique
  description String
  discountType String  // "percentage" or "fixed"
  discountValue Float  // percentage (0-100) or fixed amount in cents
  minimumOrderAmount Float? // minimum order amount required
  maxUses     Int?     // maximum number of times this code can be used
  currentUses Int      @default(0)
  validFrom   DateTime @default(now())
  validUntil  DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Order {
  id               String   @id @default(uuid())
  items            Json     // Array of cart items (id, title, price, quantity, image)
  total            Float
  discountAmount   Float    @default(0)
  finalTotal       Float
  promoCodeId      String?
  promoCode        PromoCode? @relation(fields: [promoCodeId], references: [id])
  fulfillmentType  String   
  pickupLocation   String?  
  shippingAddress  Json?    
  email            String?
  customerName     String?
  source           String   @default("online") // "online" or "in-shop" (QR scan at the shop)
  paidAt           DateTime? // set when Stripe confirms payment (orders are created before payment)
  refundedAmount   Float?   // total refunded so far, from Stripe (equals finalTotal when fully refunded)
  refundedAt       DateTime?
  restockedAt      DateTime? // set when an admin put a refunded order's books back in stock
  location         String?  // venue slug from the QR link (?loc=cafe-a)
  paymentMethod    String?  // "apple_pay" | "google_pay" | "card" | "link" | ... (from Stripe, set by the webhook)
  device           String?  // "ios" | "android" | "desktop" | "other" (from the browser, never the raw user agent)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Physical shelf count vs the system's stock number, to measure shrinkage (books that left unpaid, miscounts)
model StockCount {
  id           String   @id @default(uuid())
  bookId       String?
  book         Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)
  bookTitle    String   // kept so history still reads well if the book is deleted
  costPrice    Float?   // snapshot, to value the shrinkage
  systemStock  Int
  countedStock Int
  difference   Int      // counted - system (negative = missing books)
  adjusted     Boolean  @default(false) // true if the book's stock was updated to the counted number
  location     String?
  countedAt    DateTime @default(now())

  @@index([countedAt])
}

// "What book do you wish we had?" answers from the in-shop receipt page
model Feedback {
  id        String   @id @default(uuid())
  orderId   String?
  message   String
  location  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Small key/value settings editable from the admin (e.g. current_venue: where the books are today)
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

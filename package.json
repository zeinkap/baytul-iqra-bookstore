{
  "name": "baytul-iqra-bookstore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npx prisma generate && node scripts/migrateOnProduction.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "npx prisma generate",
    "studio": "npx prisma studio",
    "db:backup": "npx tsx scripts/createBackup.ts",
    "db:restore": "npx tsx scripts/restoreFromBackup.ts",
    "qr:venue-signs": "npx tsx scripts/generateVenueSigns.ts",
    "qr:generate": "npx tsx scripts/generateQrCodes.ts",
    "db:sync-from-prod": "npx tsx scripts/syncProdToLocal.ts",
    "db:migrate": "npx prisma migrate dev",
    "db:seed-test": "npx tsx scripts/seedTestData.ts",
    "db:reset": "npx prisma migrate reset",
    "migrate:status": "npx prisma migrate status",
    "typecheck": "tsc --noEmit",
    "lintcheck": "npm run lint",
    "start:prod": "npm run build && npm run start",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report test-results/html-report",
    "test:codegen": "playwright codegen http://localhost:3000",
    "test:prod": "NODE_ENV=production playwright test",
    "test:server": "playwright test --config=playwright.config.server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@neondatabase/serverless": "^1.0.1",
    "@prisma/client": "^6.17.1",
    "@stripe/react-stripe-js": "^3.11.0",
    "@stripe/stripe-js": "^7.3.0",
    "@types/csv-parse": "^1.1.12",
    "@vercel/speed-insights": "^1.2.0",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "keen-slider": "^6.8.6",
    "next": "^16.4.1",
    "node-fetch": "^2.7.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.5.2",
    "react-select": "^5.10.1",
    "resend": "^4.6.0",
    "stripe": "^18.1.1",
    "yet-another-react-lightbox": "^3.23.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.53.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-fetch": "^2.6.12",
    "@types/pg": "^8.10.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "prisma": "^6.17.1",
    "tailwindcss": "^4.1.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}

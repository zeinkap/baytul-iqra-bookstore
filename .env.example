# Copy to .env and fill in. Never commit .env or .env.production.
# Local development should use a LOCAL database and Stripe TEST keys.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookstore"
# Only for `npm run db:sync-from-prod` (or put DATABASE_URL in .env.production). Read-only use.
# PROD_DATABASE_URL=""

# --- Site ---
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Stripe (use sk_test_ / pk_test_ keys locally) ---
STRIPE_SECRET_KEY=""
# From `stripe listen` locally, or the webhook endpoint in the Stripe Dashboard
STRIPE_WEBHOOK_SECRET=""
# Apple Pay / Google Pay buttons on the scan and basket pages; without it only the card button shows
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Admin panel ---
ADMIN_PASSWORD=""
# Signs admin session cookies. Generate with: openssl rand -hex 32 (falls back to ADMIN_PASSWORD if unset)
ADMIN_SESSION_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""

# --- Claude: chat assistant and the age-range / description / price research scripts ---
ANTHROPIC_API_KEY=""
# Optional: override the chat assistant's model
# CHAT_MODEL=""
# Optional: override the model used by scripts/suggestPrices.ts
# PRICE_MODEL=""

# --- Production only (set in Vercel) ---
# Lets Vercel Cron call /api/cron/daily-summary (now sent monthly; the path is unchanged)
# CRON_SECRET=""
